{
  "name": "@phoenix-ai/dsh-agent-team",
  "description": "Implicit-root Agent Teams roster, durable peer mailbox, and shared task DAG",
  "version": "0.1.1-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arisnachy/phoenix-harnes.git",
    "directory": "packages/subagent/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./chat-types": {
      "types": "./lib/types/chat-types.d.ts",
      "default": "./lib/types/chat-types.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@phoenix-ai/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "emoji-regex": "10.6.0"
  },
  "peerDependencies": {
    "@phoenix-ai/dsh-agent": "workspace:^",
    "@phoenix-ai/dsh-brand": "workspace:^",
    "@phoenix-ai/dsh-invariants": "workspace:^",
    "@phoenix-ai/dsh-llm": "workspace:^",
    "@phoenix-ai/dsh-session": "workspace:^",
    "@phoenix-ai/dsh-session-persistence": "workspace:^",
    "@phoenix-ai/dsh-subagent": "workspace:^",
    "@phoenix-ai/cordis": "workspace:^",
    "@phoenix-ai/dsh-typert-protocol": "workspace:^",
    "@phoenix-ai/dsh-session-projection": "workspace:^"
  },
  "devDependencies": {
    "@phoenix-ai/dsh-agent": "workspace:^",
    "@phoenix-ai/dsh-agent-loop": "workspace:^",
    "@phoenix-ai/dsh-agent-loop-testkit": "workspace:^",
    "@phoenix-ai/dsh-brand": "workspace:^",
    "@phoenix-ai/dsh-invariants": "workspace:^",
    "@phoenix-ai/dsh-llm": "workspace:^",
    "@phoenix-ai/dsh-session": "workspace:^",
    "@phoenix-ai/dsh-session-persistence": "workspace:^",
    "@phoenix-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@phoenix-ai/dsh-session-persistence-sqlite": "workspace:^",
    "@phoenix-ai/dsh-subagent": "workspace:^",
    "@phoenix-ai/dsh-subagent-fork-in-process": "workspace:^",
    "@phoenix-ai/dsh-subagent-spawn-in-process": "workspace:^",
    "@phoenix-ai/cordis": "workspace:^",
    "@phoenix-ai/dsh-typert-protocol": "workspace:^",
    "@phoenix-ai/dsh-session-projection": "workspace:^",
    "@phoenix-ai/dsh-tools": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
