{
  "name": "@phoenix-ai/dsh-session-learning",
  "description": "Persistent, provenance-aware interaction learning memory for PHOENIX",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arisnachy/phoenix-harnes.git",
    "directory": "packages/session/session-learning"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./ledger": {
      "types": "./lib/types/ledger.d.ts",
      "default": "./lib/ledger.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/ledger.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@phoenix-ai/dsh-invariants": "workspace:^",
    "@phoenix-ai/dsh-session": "workspace:^",
    "@phoenix-ai/cordis": "workspace:^",
    "@phoenix-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@phoenix-ai/dsh-brand": "workspace:^",
    "@phoenix-ai/dsh-invariants": "workspace:^",
    "@phoenix-ai/dsh-session": "workspace:^",
    "@phoenix-ai/dsh-llm": "workspace:^",
    "@phoenix-ai/cordis": "workspace:^",
    "@phoenix-ai/schemastery": "workspace:^"
  }
}
