{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arisnachy/phoenix-harnes/blob/main/packages/phoenix-auth-bridge/schema/phoenix-envelope.schema.json",
  "title": "PhoenixEnvelope v1 (manual relay only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "message_id", "thread_id", "turn", "sender", "recipient", "intent", "payload", "created_at", "origin", "reply_to"],
  "properties": {
    "protocol": {"const": "phoenix-auth-bridge"},
    "version": {"const": 1},
    "message_id": {"type": "string", "format": "uuid"},
    "thread_id": {"type": "string", "format": "uuid"},
    "turn": {"type": "integer", "minimum": 1, "maximum": 12},
    "sender": {"enum": ["chatgpt", "gemini", "arisnachy"]},
    "recipient": {"enum": ["chatgpt", "gemini", "arisnachy"]},
    "intent": {"enum": ["proposal", "code_review", "research", "verdict", "general"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 12000}}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "origin": {"enum": ["manual-user-entry", "mcp-agent-proposal"]},
    "reply_to": {"anyOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]}
  },
  "description": "Sender labels are user-supplied and never attest to model identity. The mcp-agent-proposal origin only permits drafting for manual approval; no browser access or auto-send is authorized."
}
