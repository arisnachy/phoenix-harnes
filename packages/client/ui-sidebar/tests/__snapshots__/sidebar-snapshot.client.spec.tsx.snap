// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
  >
    <div
      class="logoRow"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <img
                alt=""
                aria-hidden="true"
                draggable="false"
                height="38"
                src="/phoenix-emblem.png"
                width="38"
              />
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="fallbackBrandName"
              >
                PHOENIX
              </span>
              <span
                class="buildRevision"
              >
                abc1234
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          class="panelIcon"
          data-content="35f95b0c"
          fill="none"
          height="16"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <svg
        data-content="c0ce4dcc"
        fill="none"
        height="14"
        viewBox="0 0 16 16"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      />
      <span
        class="newSessionLabel wide"
      >
        New Session
      </span>
    </button>
    <nav
      aria-label="Navegación principal"
      class="primaryNavigation"
    >
      <button
        aria-label="Home"
        class="navLink"
        type="button"
      >
        <svg
          aria-hidden="true"
          data-content="8c4dfd2f"
          fill="none"
          height="19"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.9"
          viewBox="0 0 24 24"
          width="19"
        />
        <span>
          Home
        </span>
      </button>
      <button
        aria-label="Discover"
        class="navLink"
        type="button"
      >
        <svg
          data-content="f23fa4b8"
          fill="none"
          height="19"
          viewBox="0 0 14 14"
          width="19"
          xmlns="http://www.w3.org/2000/svg"
        />
        <span>
          Discover
        </span>
      </button>
      <button
        aria-label="Connectors"
        class="navLink"
        type="button"
      >
        <svg
          data-content="dc3fcb5f"
          fill="none"
          height="19"
          viewBox="0 0 16 16"
          width="19"
          xmlns="http://www.w3.org/2000/svg"
        />
        <span>
          Connectors
        </span>
      </button>
      <button
        aria-label="Team"
        class="navLink"
        type="button"
      >
        <svg
          data-content="56ac24c5"
          fill="none"
          height="19"
          viewBox="0 0 16 16"
          width="19"
          xmlns="http://www.w3.org/2000/svg"
        />
        <span>
          Team
        </span>
      </button>
      <button
        aria-label="Library"
        class="navLink"
        type="button"
      >
        <svg
          data-content="7d0b657c"
          fill="none"
          height="19"
          viewBox="0 0 16 16"
          width="19"
        />
        <span>
          Library
        </span>
      </button>
    </nav>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

