{
  "name": "@phoenix-ai/dsh-web-search-openrouter",
  "description": "OpenRouter server-tool web search provider for the PHOENIX web capability seam",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arisnachy/phoenix-harnes.git",
    "directory": "packages/web/web-search-openrouter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
