    "@phoenix-ai/dsh-launch-environment": "workspace:^",
    "@phoenix-ai/dsh-invariants": "workspace:^",
    "@phoenix-ai/dsh-session": "workspace:^",
    "@phoenix-ai/dsh-settings": "workspace:^",
    "@phoenix-ai/dsh-web": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": { "@deepseek-ai/schemastery": "workspace:^" },
  "devDependencies": {
    "@phoenix-ai/dsh-agent": "workspace:^",
    "@phoenix-ai/dsh-credentials": "workspace:^",
    "@phoenix-ai/dsh-launch-environment": "workspace:^",
    "@phoenix-ai/dsh-invariants": "workspace:^",
    "@phoenix-ai/dsh-session": "workspace:^",
    "@phoenix-ai/dsh-settings": "workspace:^",
    "@phoenix-ai/dsh-web": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
