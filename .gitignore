# TypeScript project-reference artifacts emitted beside sources by some Windows
# toolchain combinations. Source files in these packages remain tracked.
packages/core/agent/src/*.js
packages/core/agent/src/*.js.map
packages/core/agent/src/*.d.ts
packages/core/agent/src/*.d.ts.map
packages/core/scope/src/*.js
packages/core/scope/src/*.js.map
packages/core/scope/src/*.d.ts
packages/core/scope/src/*.d.ts.map
packages/core/session/src/*.js
