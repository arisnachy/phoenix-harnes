# Local KIRA runtime state and captured evidence are private to each
# installation. Reusable mission, architecture, roster, and lab templates
# under .kira remain versionable.
.kira/audits/
.kira/state.md
.kira/evidence.md
.kira/failures.md
.kira/memory/
.kira/labs/phoenix-self/
